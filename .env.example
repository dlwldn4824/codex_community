# 서버에서 Codex 수정안을 실제로 생성하려면 아래 값을 설정하세요.
# 실제 키는 .env에만 넣고 Git에 커밋하지 않습니다.
OPENAI_API_KEY=

# 비용과 속도를 고려해 기본적으로 파일 3개까지만 수정안을 만듭니다. (1~10)
VIBECHECK_REPAIR_MAX_ITEMS=3

# 필요하면 모델을 바꿀 수 있습니다.
VIBECHECK_REPAIR_MODEL=gpt-5.6-terra

# 선택 사항: 자체 V6 사실 추론 모델을 RunPod 또는 별도 서버에 올렸을 때 연결합니다.
# 비어 있으면 Golden Demo는 실제 HTTP 증거 기반 결정적 추출기로 동작합니다.
NEURAL_FACTS_ENDPOINT=
NEURAL_FACTS_API_KEY=
